<form class="{{cssClass}} flexcol" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{img}}" data-edit="img" title="{{name}}" />
    <div class="header-info">
      <h1 class="charname">
        <input name="name" type="text" value="{{name}}" placeholder="Name" />
      </h1>
      <div class="grid grid-4col">
        <div
          class="flex-group-center"
          title="{{localize "wh4e.item.defenseValue"}}"
        >
          <label for="system.combat.defenseValue">
            {{localize "wh4e.actor.defenseValue"}}
          </label>
          <div class="flexrow flex-center">
            <input
              type="text"
              name="system.combat.defenseValue"
              value="{{system.combat.defenseValue}}"
              data-dtype="Number"
              title="{{localize "wh4e.tooltip.monsterDefense"}}"
            />
          </div>
        </div>
        <div class="flex-group-center">
          <label for="system.combat.harmDice.base">
            {{localize "wh4e.actor.harmDice"}}
          </label>
          <div class="flexrow flex-center">
            <input
              type="text"
              name="system.combat.harmDice.base"
              value="{{system.combat.harmDice.base}}"
              data-dtype="Number"
              class="harmDiceBase"
              title="{{localize "wh4e.tooltip.monsterHDInfo"}}"
            />
            &nbsp;+&nbsp;
            <input
              type="text"
              name="system.combat.harmDice.modifier"
              value="{{system.combat.harmDice.modifier}}"
              data-dtype="String"
              title="{{localize "wh4e.tooltip.monsterHDAnyValue"}}"
            />
          </div>
        </div>
        <div class="flex-group-center">
          <label for="system.harmPoints.value">
            {{localize "wh4e.actor.harmPoints"}}
          </label>
          <div class="flexrow flex-center">
            <input
              type="text"
              name="system.harmPoints.value"
              value="{{system.harmPoints.value}}"
              data-dtype="Number"
              title="{{localize "wh4e.tooltip.hpCurrent"}}"
            />
            &nbsp;/&nbsp;
            <input
              type="text"
              name="system.harmPoints.max"
              value="{{system.harmPoints.max}}"
              data-dtype="Number"
              title="{{localize "wh4e.tooltip.hpMax"}}"
            />
          </div>
        </div>
        <div class="flex-group-center">
          <label for="system.movement">
            {{localize "wh4e.actor.movement"}}
          </label>
          <div class="flexrow flex-center">
            <input
              type="text"
              name="system.movement"
              value="{{system.movement}}"
              data-dtype="Number"
              title="{{localize "wh4e.tooltip.movement"}}"
            />
          </div>
        </div>
      </div>
      <div class="grid grid-5col">
        <div class="flex-group-center">
          <label for="system.damage" class="damage-roll">
            {{localize "wh4e.item.damage"}}
          </label>
          <div class="flexrow flex-center">
            <input
              name="system.damage"
              type="text"
              class="center-text"
              value={{system.damage}}
              data-dtype="String"
              placeholder="1d6"
            />
          </div>
        </div>
        <div class="flex-group-center">
          <label for="system.savingThrow" class="rollable savingThrow">
            <i class="fas fa-dice"></i>
            &nbsp;{{localize "wh4e.actor.savingThrow"}}
          </label>
          <div class="flexrow flex-center">
            <input
              type="text"
              name="system.savingThrow"
              value="{{system.savingThrow}}"
              class="read-only"
              data-dtype="Number"
              readonly="readonly"
              title="{{localize "wh4e.tooltip.monsterSavingThrow"}}"
            />
          </div>
        </div>
        <div class="flex-group-center">
          <label for="system.combat.attackValue" class="rollable attack-roll">
            <i class="fas fa-dice"></i>
            &nbsp;{{localize "wh4e.actor.attackValue"}}
          </label>
          <div class="flexrow flex-center">
            <input
              type="text"
              name="system.combat.attackValue"
              value="{{system.combat.attackValue}}"
              class="read-only"
              data-dtype="Number"
              readonly="readonly"
              title="{{localize "wh4e.tooltip.monsterAttackValue"}}"
            />
          </div>
        </div>
        <div class="flex-group-center">
          {{#if hasToken}}
            <label for="system.attributes.dex.mod" class="rollable init-label">
              <i class="fas fa-dice"></i>
              &nbsp;{{localize "wh4e.actor.initiative"}}
            </label>
          {{else}}
            <label for="system.attributes.dex.mod">
              {{localize "wh4e.actor.initiative"}}
            </label>
          {{/if}}
          <div class="flexrow flex-center">
            <input
              type="text"
              name="system.attributes.dex.mod"
              value="{{system.attributes.dex.mod}}"
              data-dtype="Number"
              title="{{localize "wh4e.tooltip.initiative"}}"
            />
          </div>
        </div>
        <div class="flex-group-center">
          <label for="system.xp">
            {{localize "wh4e.actor.monster.xp"}}
          </label>
          <div class="flexrow flex-center">
            <input
              type="text"
              name="system.xp"
              value="{{system.xp}}"
              data-dtype="Number"
              title="{{localize "wh4e.tooltip.monsterXP"}}"
            />
          </div>
        </div>
      </div>
    </div>
  </header>
  <div class="sheet-content">
    <div class="full-width-field">
      <label for="system.special" style="font-weight: bold;">
        {{localize "wh4e.item.special"}}
      </label>
      <input
        id="system.special"
        class="special-input"
        name="system.special"
        type="text"
        value="{{system.special}}"
        data-dtype="String"
      />
    </div>
    <div class="actor-notes">
      <label for="system.notes" style="font-weight: bold;">
        {{localize "wh4e.item.notes"}}
      </label>
      {{editor
        enrichedNotes
        target="system.notes"
        button=true
        owner=owner
        editable=editable
      }}
    </div>
  </div>
</form>