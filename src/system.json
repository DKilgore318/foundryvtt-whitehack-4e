{
  "name": "whitehack4e",
  "title": "Whitehack Fourth Edition",
  "description": "A system for playing Whitehack Fourth Edition",
  "authors": [
    {
      "name": "Neil Benson (@OldScouserRPing)"
    },
    {
      "name": "Daniel Kilgore"
    }
  ],
  "version": "1.5.0",
  "compatibility": {
    "minimum": "12.324",
    "verified": "12.331"
  },
  "esmodules": ["wh4e.js"],
  "styles": ["css/wh4e.css"],
  "packs": [
    {
      "name": "ability",
      "label": "Abilities",
      "path": "packs/ability",
      "type": "Item",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "actor",
      "label": "Actors",
      "path": "packs/actor",
      "type": "Actor",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "armour",
      "label": "Armour",
      "path": "packs/armour",
      "type": "Item",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "gear",
      "label": "Gear",
      "path": "packs/gear",
      "type": "Item",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "journal",
      "label": "Journals",
      "path": "packs/journal",
      "type": "JournalEntry",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "macro",
      "label": "Macros",
      "path": "packs/macro",
      "type": "Macro",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "provision",
      "label": "Provision",
      "path": "packs/provision",
      "type": "Adventure",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "roll-table",
      "label": "Roll Tables",
      "path": "packs/roll-table",
      "type": "RollTable",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "weapon",
      "label": "Weapons",
      "path": "packs/weapon",
      "type": "Item",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "harmPoints",
  "initiative": "1d6 + @attributes.agi.mod",
  "url": "https://github.com/neilbenson/foundryvtt-whitehack-4e",
  "manifest": "https://raw.githubusercontent.com/neilbenson/foundryvtt-whitehack-4e/main/src/system.json",
  "download": "https://github.com/neilbenson/foundryvtt-whitehack-4e/releases/download/1.4.0/foundryvtt-whitehack4e-v1.4.0.zip"
}
