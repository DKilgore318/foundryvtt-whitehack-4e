{
  "name": "whitehack4e",
  "title": "Whitehack Fourth Edition",
  "description": "A system for playing Whitehack Fourth Edition",
  "author": "Neil Benson (@OldScouserRPing), maintained by Daniel Kilgore",
  "version": "1.5.0",
  "minimumCoreVersion": "10.285",
  "compatibleCoreVersion": "12.331",
  "esmodules": ["wh4e.js"],
  "styles": ["css/wh4e.css"],
  "packs": [
    {
      "name": "armour",
      "label": "Armour",
      "path": "/packs/armour.db",
      "type": "Item"
    },
    {
      "name": "gear",
      "label": "Gear",
      "path": "/packs/gear.db",
      "type": "Item"
    },
    {
      "name": "weapons",
      "label": "Weapons",
      "path": "/packs/weapons.db",
      "type": "Item"
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "gridDistance": 5,
  "gridUnits": "ft",
  "primaryTokenAttribute": "harmPoints",
  "initiative": "1d6 + @attributes.dex.mod",
  "url": "https://github.com/neilbenson/foundryvtt-whitehack-4e",
  "manifest": "https://raw.githubusercontent.com/neilbenson/foundryvtt-whitehack-4e/main/src/system.json",
  "download": "https://github.com/neilbenson/foundryvtt-whitehack-4e/releases/download/1.4.0/foundryvtt-whitehack4e-v1.4.0.zip"
}
